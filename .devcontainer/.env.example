# Copy this file to .devcontainer/.env and fill in the values.
# .env is gitignored — never commit it.
#
# GITHUB_TOKEN — fine-grained personal access token with Models:Read.
# Required for Path B (GitHub Models direct REST). Path A (Copilot CLI / SDK)
# does NOT need this; it uses `gh auth login` instead.
#
# Generate one at:
#   https://github.com/settings/personal-access-tokens/new
# Name:        anything, e.g. "BUILD 2026 demo"
# Expiration:  past your demo date
# Permissions: Account permissions → Models → Read
#
# In Codespaces this file is auto-created empty; configure GITHUB_TOKEN as a
# Codespaces user/repo secret instead.

GITHUB_TOKEN=
